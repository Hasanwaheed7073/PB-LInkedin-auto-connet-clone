# ---------------------------------------------------------------------------
# LinkedIn Outreach Operations Platform - environment configuration
#
# Copy to `.env` and fill in. NEVER commit `.env`.
# No LinkedIn username or password belongs in this file, or anywhere else in
# this project. The browser session is authenticated by hand, once, in a real
# browser window (see README, "Authenticate the browser session").
# ---------------------------------------------------------------------------

# --- Database (PostgreSQL) -------------------------------------------------
#
# Option A - Supabase (recommended for anything other than local dev).
#   DATABASE_URL uses the pooled connection (port 6543, pgbouncer).
#   DIRECT_DATABASE_URL uses the direct connection (port 5432) and is what
#   `prisma migrate` needs, because migrations cannot run over a transaction
#   pooler.
#
# DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# DIRECT_DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"
#
# Option B - local PostgreSQL started by `npm run db:local`.
#   That command downloads and runs a real PostgreSQL server on port 55432;
#   it needs no Docker and no system Postgres install.
DATABASE_URL="postgresql://outreach:outreach@127.0.0.1:55432/outreach?schema=public"
DIRECT_DATABASE_URL="postgresql://outreach:outreach@127.0.0.1:55432/outreach?schema=public"

# --- Dashboard session -----------------------------------------------------
# Signing key for the dashboard session cookie. Generate a fresh one:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET="replace-me-with-at-least-32-random-characters"

# Seed operator account, created by `npm run db:seed`. The password is stored
# only as a scrypt hash; the plaintext here is read once at seed time.
SEED_USER_EMAIL="operator@example.com"
SEED_USER_NAME="Operator"
SEED_USER_PASSWORD="change-this-before-seeding"

# --- Worker <-> API authentication -----------------------------------------
# Shared bearer token the worker presents to /api/worker/*. The worker holds no
# database credentials; this token is its only access path.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
WORKER_API_TOKEN="replace-me-with-at-least-32-random-characters"

# Base URL of the dashboard, as reachable from the worker process.
WORKER_API_BASE_URL="http://127.0.0.1:3000"

# Human-readable worker name shown on the dashboard.
WORKER_NAME="local-worker-1"

# --- Worker runtime --------------------------------------------------------
# Directory holding the persistent Playwright browser profile (cookies, local
# storage). Treat this like a password store: it grants access to the logged-in
# LinkedIn session. Keep it out of version control and off shared drives.
BROWSER_PROFILE_DIR="./.data/browser-profile"

# Where the worker writes incident screenshots.
SCREENSHOT_DIR="./.data/screenshots"

# Run the browser with a visible window. Keep `false` for unattended runs and
# set `true` when you need to log in by hand or watch what the worker is doing.
WORKER_HEADLESS="false"

# Heartbeat cadence, and the age at which a worker is declared unhealthy.
WORKER_HEARTBEAT_INTERVAL_MS="10000"
WORKER_HEARTBEAT_STALE_MS="45000"

# How often the worker re-checks the kill switch while a job is in flight.
WORKER_CONTROL_POLL_MS="3000"

# Hard ceiling on how long one job may take before it is abandoned as a
# technical failure.
WORKER_JOB_TIMEOUT_MS="120000"

# Navigation timeout for a single LinkedIn page load.
WORKER_NAV_TIMEOUT_MS="45000"

# --- Safety limits ---------------------------------------------------------
# Absolute per-day ceiling across every campaign combined. This is enforced on
# top of each campaign's own dailyLimit and cannot be exceeded by adding more
# campaigns. Keep it conservative.
GLOBAL_DAILY_ACTION_LIMIT="40"

# Maximum length accepted for a rendered connection note. LinkedIn's own limit
# has changed over time and differs between account types, so this is a
# configurable guard rather than a hardcoded assumption.
MAX_CONNECTION_NOTE_CHARS="280"

# --- Testing ---------------------------------------------------------------
# Base URL of the local mock-LinkedIn fixture server used by the worker tests.
# Never point this at linkedin.com.
MOCK_LINKEDIN_BASE_URL="http://127.0.0.1:4010"

# ---------------------------------------------------------------------------
# Lead finder: web-search discovery (optional)
#
# Finds LinkedIn profile URLs through a search engine API, reading only what the
# engine has already indexed. linkedin.com is never contacted and no LinkedIn
# account is involved. Set ONE of these.
# ---------------------------------------------------------------------------
#SERPER_API_KEY=""
#BRAVE_API_KEY=""

# ---------------------------------------------------------------------------
# Operator alerting (strongly recommended before running unattended)
#
# A Slack or Discord incoming-webhook URL. When automation halts - CAPTCHA,
# expired session, account restriction - the alert goes here. Without it a
# worker that stops at 03:00 stays stopped until somebody happens to look.
# ---------------------------------------------------------------------------
#ALERT_WEBHOOK_URL=""
# Used to build the incidents link inside the alert.
#DASHBOARD_BASE_URL="https://your-project.vercel.app"
